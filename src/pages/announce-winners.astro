---
import OSHW from "../assets/Images/logo_3.png";

import iitbLogo from '../announce-result/FOSSEE_Makeathon_Winners_Project/images/iitb.jpg';
import fosseeLogo from '../announce-result/FOSSEE_Makeathon_Winners_Project/images/fossee.png';
import openHardwareLogo from '../announce-result/FOSSEE_Makeathon_Winners_Project/images/openhw.png';

import landslideIcon from '../announce-result/FOSSEE_Makeathon_Winners_Project/images/landslide.png';
import forestfireIcon from '../announce-result/FOSSEE_Makeathon_Winners_Project/images/forestfire.png';
import biohazardIcon from '../announce-result/FOSSEE_Makeathon_Winners_Project/images/biohazard.jpg';

import '../announce-result/FOSSEE_Makeathon_Winners_Project/css/tokens.css';
import '../announce-result/FOSSEE_Makeathon_Winners_Project/css/base.css';
import '../announce-result/FOSSEE_Makeathon_Winners_Project/css/brand-bar.css';
import '../announce-result/FOSSEE_Makeathon_Winners_Project/css/masthead.css';
import '../announce-result/FOSSEE_Makeathon_Winners_Project/css/podium.css';
import '../announce-result/FOSSEE_Makeathon_Winners_Project/css/controls.css';
import '../announce-result/FOSSEE_Makeathon_Winners_Project/css/effects.css';
import '../announce-result/FOSSEE_Makeathon_Winners_Project/css/animations.css';
import '../announce-result/FOSSEE_Makeathon_Winners_Project/css/responsive.css';

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b4f4a">
  <meta name="description" content="Winners reveal for the FOSSEE Open Hardware Make-a-thon 2026 on Disaster Detection and Early Warning Systems.">
  <title>FOSSEE Open Hardware Make-a-thon 2026 — Winners</title>

  <style>
    .winner__project-icon {
      flex: none;
      width: 1.15em;
      height: 1.15em;
      object-fit: contain;
    }
  </style>
<link rel="icon" type="image/png" href={OSHW.src} />
</head>
<body>
  <!-- Inline SVG icon sprite (offline-friendly) -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <symbol id="icon-mountain" viewBox="0 0 24 24"><path fill="currentColor" d="M1 20 9 6l4.5 7.5L16 10l7 10z"/></symbol>
      <symbol id="icon-droplet" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C9 6.5 5.5 10 5.5 14.5a6.5 6.5 0 0 0 13 0C18.5 10 15 6.5 12 2z"/></symbol>
      <symbol id="icon-flame" viewBox="0 0 24 24"><path fill="currentColor" d="M13 2c.6 4.2 5.5 6.2 5.5 12a6.5 6.5 0 0 1-13 0c0-2.6 1.2-4.2 2.6-5.6.1 2 .9 3.2 2.1 3.6C9.4 8.4 10.5 4.6 13 2z"/></symbol>
      <symbol id="icon-crown" viewBox="0 0 24 24"><path fill="currentColor" d="M2 7l5 4 5-7 5 7 5-4-2 12H4z"/></symbol>
      <polygon id="ray" points="0,0 -9,-150 9,-150" />
    </defs>
  </svg>

  <main class="screen" id="screen">
    <div class="screen__grid" aria-hidden="true"></div>

    <header class="masthead">
      <div class="brand-bar" role="group" aria-label="Organising institutions">
        <img class="brand-bar__logo" src={iitbLogo.src} alt="IIT Bombay" width="877" height="840">
        <span class="brand-bar__divider" aria-hidden="true"></span>
        <img class="brand-bar__logo" src={fosseeLogo.src} alt="FOSSEE" width="1883" height="695">
        <span class="brand-bar__divider" aria-hidden="true"></span>
        <img class="brand-bar__logo" src={openHardwareLogo.src} alt="Open Hardware" width="1647" height="733">
      </div>
      <h1 class="masthead__title">FOSSEE <span class="masthead__accent">OPEN HARDWARE</span></h1>
      <p class="masthead__event">MAKE-A-THON 2026</p>
      <p class="masthead__theme">DISASTER DETECTION &amp; EARLY WARNING SYSTEMS</p>
    </header>

    <section class="intro">
      <h2 class="intro__title">And the winners are</h2>
      <p class="intro__tagline">Celebrating bold ideas, brilliant builds, and technology for impact</p>
    </section>

    <section class="podium" aria-label="Make-a-thon winners">

      <!-- 3rd place -->
      <article class="winner winner--third" id="third" aria-label="Third place">
        <div class="winner__medal">
          <span class="winner__ring" aria-hidden="true"></span>
          <span class="winner__disc" aria-hidden="true">3</span>
        </div>
        <div class="winner__plinth">
          <p class="winner__rank">Third place</p>
          <ul class="winner__names">
            <li style="--i:0">Sai Rajendra Mone </li>
            <li style="--i:1">Swalaj Barai</li>
            <li style="--i:2">Aditya Kulkarni</li>
            <li style="--i:3">Atharva Shende</li>
          </ul>
          <div class="winner__project">
            <span class="winner__project-label">Project</span>
            <span class="winner__project-title">
               <img class="winner__project-icon" src={forestfireIcon.src} alt="" width={forestfireIcon.width} height={forestfireIcon.height}>
             Forest Fire Detection
            </span>
          </div>
        </div>
      </article>

      <!-- 1st place -->
      <article class="winner winner--first" id="first" aria-label="First place, champion">
        <div class="winner__medal">
          <svg class="winner__rays" viewBox="-150 -150 300 300" aria-hidden="true">
            <g class="winner__rays-spin" fill="currentColor" fill-opacity="0.28">
              <use href="#ray"/><use href="#ray" transform="rotate(30)"/><use href="#ray" transform="rotate(60)"/>
              <use href="#ray" transform="rotate(90)"/><use href="#ray" transform="rotate(120)"/><use href="#ray" transform="rotate(150)"/>
              <use href="#ray" transform="rotate(180)"/><use href="#ray" transform="rotate(210)"/><use href="#ray" transform="rotate(240)"/>
              <use href="#ray" transform="rotate(270)"/><use href="#ray" transform="rotate(300)"/><use href="#ray" transform="rotate(330)"/>
            </g>
          </svg>
          <svg class="winner__crown" aria-hidden="true"><use href="#icon-crown"/></svg>
          <span class="winner__ring" aria-hidden="true"></span>
          <span class="winner__disc" aria-hidden="true">1</span>
        </div>
        <div class="winner__plinth">
          <p class="winner__rank">Champion · First place</p>
          <ul class="winner__names">
            <li id="champion-name" style="--i:0">Jagbir Singh</li>
          </ul>
          <div class="winner__project">
            <span class="winner__project-label">Project</span>
            <span class="winner__project-title">
              <img class="winner__project-icon" src={landslideIcon.src} alt="" width={landslideIcon.width} height={landslideIcon.height}>
           Landslide Detection
            </span>
          </div>
        </div>
      </article>

      <!-- 2nd place -->
      <article class="winner winner--second" id="second" aria-label="Second place">
        <div class="winner__medal">
          <span class="winner__ring" aria-hidden="true"></span>
          <span class="winner__disc" aria-hidden="true">2</span>
        </div>
        <div class="winner__plinth">
          <p class="winner__rank">Second place</p>
          <ul class="winner__names">
            <li style="--i:0">Suwid Shreyansh</li>
            <li style="--i:1">Harsimar Singh </li>
            <!-- <li style="--i:2">N Pratik</li>
            <li style="--i:3">Tushar</li> -->
          </ul>
          <div class="winner__project">
            <span class="winner__project-label">Project</span>
            <span class="winner__project-title">
              <img class="winner__project-icon" src={biohazardIcon.src} alt="" width={biohazardIcon.width} height={biohazardIcon.height}>
              Industrial Hazard Monitoring
            </span>
          </div>
        </div>
      </article>

    </section>

    <footer class="controls">
      <p class="controls__step" id="step">WINNER REVEAL · 1 OF 3</p>
      <button class="btn-reveal" id="reveal" type="button">Reveal third place</button>
      <p class="controls__announce" id="announce" aria-live="polite">Click, or press Space, to begin</p>
      <a class="controls__link" href="/announce-women">Notable women innovators &rarr;</a>
    </footer>

    <div class="fx-layer" id="fx-layer" aria-hidden="true"></div>
    <div class="flash" id="flash" aria-hidden="true"></div>
  </main>

  <!-- <script>
  const modules = import.meta.glob(
    './announce-result/FOSSEE_Makeathon_Winners_Project/js/*.js',
    { eager: true }
  );
</script> -->
<script>
  import '../announce-result/FOSSEE_Makeathon_Winners_Project/js/config.js';
  import '../announce-result/FOSSEE_Makeathon_Winners_Project/js/effects.js';
  import '../announce-result/FOSSEE_Makeathon_Winners_Project/js/reveal.js';
  import '../announce-result/FOSSEE_Makeathon_Winners_Project/js/main.js';
</script>
</body>
</html>
